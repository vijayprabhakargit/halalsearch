# Gemini API key (server-side only). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model used for halal validation.
# Defaults to a Flash-tier model.
GEMINI_MODEL=

# Optional: set to "1" to return canned verdicts without calling Gemini (no billing).
# Useful for UI development and tests.
GEMINI_MOCK=

# Optional: override the primary Overpass endpoint. If unset, a built-in list of
# public mirrors is tried in order until one responds.
# OVERPASS_URL=
OVERPASS_USER_AGENT=HalalSearch/0.1 (https://github.com/)

# Optional (disabled by default): Google Programmable Search Engine results pane
# in the place card. Kept in code but hidden unless enabled. To turn it on, set
# NEXT_PUBLIC_ENABLE_GOOGLE_CSE=1 and provide an engine id (cx) from
# https://programmablesearchengine.google.com/ (choose "Search the entire web").
# NEXT_PUBLIC_ENABLE_GOOGLE_CSE=1
NEXT_PUBLIC_GOOGLE_CSE_CX=
