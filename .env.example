# Gemini API key (server-side only). Get one at https://aistudio.google.com/apikey
# Only needed if the AI halal check is enabled (see NEXT_PUBLIC_ENABLE_AI_CHECK).
GEMINI_API_KEY=

# Optional: override the Gemini model used for halal validation.
# Defaults to a Flash-tier model.
GEMINI_MODEL=

# Optional: set to "1" to return canned verdicts without calling Gemini (no billing).
# Useful for UI development and tests.
GEMINI_MOCK=

# Optional (disabled by default): the on-demand AI halal check. When enabled, a
# place card shows a "Validate with AI" button — nothing runs automatically.
# NEXT_PUBLIC_ENABLE_AI_CHECK=1

# Optional: donation link shown next to Settings (e.g. GitHub Sponsors, Ko-fi,
# Buy Me a Coffee). Hidden when unset.
# NEXT_PUBLIC_DONATE_URL=

# OSM provider (Overpass + Photon) — kept in the repo but NOT active. Only used
# if you switch the provider in lib/providers/index.ts back to ./osm.
# OVERPASS_URL=
OVERPASS_USER_AGENT=HalalSearch/0.1 (https://github.com/)

# Optional (disabled by default): Google Programmable Search Engine results pane
# in the place card. Kept in code but hidden unless enabled. To turn it on, set
# NEXT_PUBLIC_ENABLE_GOOGLE_CSE=1 and provide an engine id (cx) from
# https://programmablesearchengine.google.com/ (choose "Search the entire web").
# NEXT_PUBLIC_ENABLE_GOOGLE_CSE=1
NEXT_PUBLIC_GOOGLE_CSE_CX=

# Community database. Defaults to a local libSQL file; point this at Turso in
# production (same client, no code change). Data is community contributions only.
# TURSO_DATABASE_URL=file:./data/halal.db
# TURSO_AUTH_TOKEN=

# Optional: secret used to sign the community identity cookie. If unset, the
# DB token above is used (stable across deploys). Set a dedicated value in prod.
# IDENTITY_SECRET=

# Optional: set to "1" to require >=2 agreeing reports and a strong majority
# before showing a community "halal" verdict. Off by default (a single halal
# vote is enough) while the app is new and accumulating data.
# COMMUNITY_STRICT_HALAL=1

# Google Maps. Create a Google Cloud project with Billing enabled and the
# "Maps JavaScript API" + "Places API (New)" turned on, then create two keys:
#  - browser key: HTTP-referrer restricted to your domains + http://localhost:3000/*
#  - server key: restricted to "Places API (New)"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
# Optional Map ID for advanced markers (defaults to DEMO_MAP_ID).
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
