# Production environment — set these in your host's dashboard (Vercel/Netlify),
# NOT in the repo. This file is a checklist only; never commit real secrets.

# --- Required ---
# Google Maps Platform: browser key (HTTP-referrer restricted) + server key
# (restricted to Places API (New)).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
# Hosted libSQL DB (serverless hosts have no persistent disk). From `turso db show`.
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# --- Recommended ---
# Secret for signing the community identity cookie (falls back to TURSO_AUTH_TOKEN).
IDENTITY_SECRET=
# Identify your app to OSM services (OSM provider only).
OVERPASS_USER_AGENT=HalalSearch/0.1 (you@example.com)

# --- Optional ---
# Map ID for advanced markers (defaults to DEMO_MAP_ID).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# On-demand AI halal check (ON by default; set to "0" to hide). Needs GEMINI_API_KEY.
NEXT_PUBLIC_ENABLE_AI_CHECK=
# Only needed if the AI check is enabled. Pin the model (the "latest" alias is
# sometimes overloaded, 503 "high demand").
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Require >=2 agreeing reports (and a strong majority) for a community "halal"
# verdict. Off by default (a single halal vote is enough).
COMMUNITY_STRICT_HALAL=
# Support/donation link shown next to Settings and in the info panel.
# Defaults to the project's Buy Me a Coffee link if unset.
NEXT_PUBLIC_DONATE_URL=
# Embedded Google Programmable Search Engine pane (off unless both are set).
NEXT_PUBLIC_ENABLE_GOOGLE_CSE=
NEXT_PUBLIC_GOOGLE_CSE_CX=
